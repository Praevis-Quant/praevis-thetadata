# Settings for scripts/live/run.sh (docs/live-runbook.md). Copy to
# scripts/live/settings.env (ignored by git) and fill in this machine's
# paths. Never put a key here: THETADATA_API_KEY comes from the environment.
#
# Read as data, never executed: KEY=VALUE per line, the value taken
# literally (spaces and backslashes need no quotes; one pair of surrounding
# quotes is removed; a leading ~/ or $HOME/ means the home folder).

# The Terminal's folder, holding ThetaTerminalv3.jar and config.toml.
#   Windows (Git Bash, a Windows path): C:\Users\<you>\.thetadata
#   WSL or Linux:                       $HOME/thetadata
THETA_TERMINAL_DIR=

# Java 21 for the Terminal.
#   Windows: the javaw.exe path, for example
#            C:\Program Files\Eclipse Adoptium\jdk-21.0.13.9-hotspot\bin\javaw.exe
#   WSL or Linux: the JDK's bin folder, put first on PATH (the Terminal's
#            bootstrapper launches lib/*.jar with `java` by name), for
#            example $HOME/opt/jdk21/bin
THETA_JAVA=

# Saved configs that --terminal live|dev copies over config.toml (the
# fpss_region differs: fpss_nj_hosts for live, fpss_dev_hosts for the dev
# replay feed). Leave empty to run with whatever config.toml holds.
THETA_CONFIG_LIVE=
THETA_CONFIG_DEV=

# The Terminal's REST address: readiness is a 200 from its expirations list.
THETA_REST=127.0.0.1:25503

# Seconds to wait after the REST answers 200, before streaming.
THETA_SETTLE=60

# The Python with the package and the bench requirements installed
# (Windows: .venv-p1/Scripts/python; WSL or Linux: .venv-p1/bin/python).
PRAEVIS_PY=

# scripts/live/wsl.sh only (Windows side): the WSL distribution and the
# repository's path inside it.
WSL_DISTRO=Ubuntu
WSL_REPO=~/praevis-thetadata
